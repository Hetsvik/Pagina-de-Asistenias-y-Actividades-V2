{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paginadeasistenciasoficial-api",
  "main": "backend/src/main.py", 
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["disable_python_external_sdk"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "disable_python_external_sdk": true  // 👈 SOLUCIÓN OFICIAL: Desactiva el SDK conflictivo a nivel de infraestructura
  },
  "d1_databases": [
    {
      "binding": "DB", 
      "database_name": "DB_Empresa",
      "database_id": "08f6f1ec-6378-4549-8d5a-8384c96aeb8e"
    }
  ]
}

